#!/usr/bin/env bun
export {};
if (process.argv[2] === 'whoami') { console.log('{}'); process.exit(0); }
let sequence = 0; let sessions = 0;
const urls = new Map<string, string>();
const prompts = new Map<string, string[]>();
const terminated: string[] = [];
const send = (value: any) => process.stdout.write(JSON.stringify(value) + '\n');
const say = (sessionId: string, text: string) => send({ method: 'session/update', params: { sessionId, update: { sessionUpdate: 'agent_message_chunk', content: { type: 'text', text } } } });
async function handle(msg: any) {
  if (msg.method === 'initialize') send({ id: msg.id, result: { protocolVersion: 1 } });
  if (msg.method === 'session/new') {
    const sessionId = `fake-${++sessions}`;
    urls.set(sessionId, msg.params.mcpServers[0]?.args[1]); prompts.set(sessionId, []);
    send({ id: msg.id, result: { sessionId } });
  }
  if (msg.method === '_kiro.dev/session/terminate') terminated.push(msg.params.sessionId);
  if (msg.method === 'session/set_model' || msg.method === '_kiro.dev/session/terminate') send({ id: msg.id, result: {} });
  if (msg.method === 'session/prompt') {
    const sessionId = msg.params.sessionId;
    const prompt = msg.params.prompt[0].text;
    prompts.get(sessionId)!.push(prompt);
    if (prompt.includes('ECHO')) {
      // Reports what this Kiro session has received, to verify follow-up prompts.
      say(sessionId, JSON.stringify({ sessionId, prompts: prompts.get(sessionId), pid: process.pid, terminated }));
    } else if (prompt.includes('TOOL')) {
      const invoke = () => fetch(urls.get(sessionId)!, { method: 'POST', body: JSON.stringify({ jsonrpc: '2.0', id: ++sequence, method: 'tools/call', params: { name: 'write', arguments: { path: 'test.txt', content: 'HELLO' } } }) }).then(r => r.json());
      const result = prompt.includes('PARALLEL') ? await Promise.all([invoke(), invoke()]) : await invoke();
      say(sessionId, JSON.stringify(result));
    } else say(sessionId, 'FAKE_OK');
    send({ id: msg.id, result: { stopReason: 'end_turn' } });
  }
}
let buffer = '';
for await (const data of Bun.stdin.stream()) {
  buffer += new TextDecoder().decode(data);
  let end: number;
  while ((end = buffer.indexOf('\n')) >= 0) { const line = buffer.slice(0, end); buffer = buffer.slice(end + 1); if (line) void handle(JSON.parse(line)); }
}
